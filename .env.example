# ==============================================================================
# Crochet Store - Environment Variables Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Crochet Store
APP_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required for database, auth, and storage.
# Obtain from: Supabase Project Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY: Never expose to browser code
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Razorpay Configuration (Payment Gateway)
# Obtain from: Razorpay Dashboard -> Settings -> API Keys & Webhooks
# SERVER-ONLY: Never expose secrets to browser code
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Resend Configuration (Transactional Emails)
# Obtain from: Resend Dashboard -> API Keys & Domains
# SERVER-ONLY: Never expose to browser code
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# Sentry Configuration (Application Monitoring & Error Tracking)
# Obtain from: Sentry Project Settings -> Client Keys (DSN)
# ------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------------------
# Shiprocket Configuration (Logistics & Shipping for India)
# Obtain from: Shiprocket Account -> API Settings
# SERVER-ONLY: Never expose to browser code
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
